# =============================================================================
# LOCAL DEVELOPMENT (.env) — copy to .env and fill
# =============================================================================

# Supabase (when set, API uses cloud DB instead of local SQLite)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Tracker login key (enter this in the Vue unlock screen)
TRACKER_API_KEY=change-me
TRACKER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local-only fallback when Supabase is unset
LOCAL_DB_PATH=data/tracker.sqlite

# =============================================================================
# VERCEL — only these 4 (see also vercel.env.example for import)
# =============================================================================
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# TRACKER_API_KEY
# TRACKER_CORS_ORIGINS=https://your-app.vercel.app

# =============================================================================
# GITHUB ACTIONS — scrape cron secrets (repo Settings → Actions secrets)
# =============================================================================
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# Optional: SCRAPE_KEYWORDS, SCRAPE_MAX_PER_SOURCE

SCRAPE_KEYWORDS=python,data analyst,data engineer,data engineering,fastapi,etl,pandas,sql,pipeline,metocean,analytics,data cleaning,data visualization,django,postgres
SCRAPE_MAX_PER_SOURCE=80

# =============================================================================
# OPTIONAL / FUTURE (not required for tracker MVP on Vercel)
# =============================================================================

# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_EXTRACTION_MODEL=openai/gpt-4o-mini
# OPENROUTER_RESUME_MODEL=openai/gpt-4o-mini
# CAREER_DATA_DIR=career_data
# SCORE_WEIGHT_SKILL=0.35
# SCORE_WEIGHT_EXPERIENCE=0.25
# SCORE_WEIGHT_ROLE=0.15
# SCORE_WEIGHT_SENIORITY=0.10
# SCORE_WEIGHT_LOCATION=0.10
# SCORE_WEIGHT_DOMAIN=0.05
