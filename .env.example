# Supabase (server / GitHub Actions / Vercel API only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Tracker API (FastAPI on Vercel). Enter this key in the Vue login screen.
TRACKER_API_KEY=change-me
TRACKER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCAL_DB_PATH=data/tracker.sqlite

# Scrape filters (GitHub Actions hourly job)
SCRAPE_KEYWORDS=python,data engineer,data engineering,fastapi,etl,pandas,sql,pipeline,metocean,ocean,analytics,ops,django,postgres
SCRAPE_MAX_PER_SOURCE=80

# OpenRouter (server-side only; used from M3+)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_EXTRACTION_MODEL=openai/gpt-4o-mini
OPENROUTER_RESUME_MODEL=openai/gpt-4o-mini

# Career data directory (relative to repo root or absolute)
CAREER_DATA_DIR=career_data

# Fit score weights (M4; reserved defaults)
SCORE_WEIGHT_SKILL=0.35
SCORE_WEIGHT_EXPERIENCE=0.25
SCORE_WEIGHT_ROLE=0.15
SCORE_WEIGHT_SENIORITY=0.10
SCORE_WEIGHT_LOCATION=0.10
SCORE_WEIGHT_DOMAIN=0.05
