# Vercel import file (Settings → Environment Variables → Import .env)
# 1. Copy to vercel.env locally
# 2. Fill real values
# 3. Import in Vercel UI for Production + Preview
# 4. Do not commit the filled vercel.env

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TRACKER_API_KEY=pick-a-long-secret-for-login
TRACKER_CORS_ORIGINS=https://tyorus-jobs.vercel.app
